<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="IconView">
        <attr name="iconType" format="enum">
            <enum name="tv" value="0" />
            <enum name="youtube" value="1" />
            <enum name="playstore" value="2" />
            <enum name="player" value="3" />
            <enum name="gear" value="4" />
            <enum name="apps" value="5" />
            <enum name="wifi" value="6" />
            <enum name="clock" value="7" />
            <enum name="calendar" value="8" />
            <enum name="info" value="9" />
            <enum name="palette" value="10" />
            <enum name="expand" value="11" />
        </attr>
        <attr name="iconTint" format="color" />
    </declare-styleable>
</resources>
