<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.analogtv.launcher.IconView
            android:id="@+id/logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tag="15"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Zavi TV"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.analogtv.launcher.IconView
            android:id="@+id/wifiIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tag="6"
            android:clickable="true"
            android:focusable="true" />
        <com.analogtv.launcher.IconView
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tag="2"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
        <com.analogtv.launcher.IconView
            android:id="@+id/btnTopSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:tag="1"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Middle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: PIP + options bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pipArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/pipCard"
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/pipPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:use_controller="false"
                        app:resize_mode="fit" />

                    <TextView
                        android:id="@+id/liveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="● LIVE"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pipToast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="#99000000"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/pipControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="6dp"
                        android:visibility="gone">

            <com.analogtv.launcher.IconView
                android:id="@+id/ctlPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:tag="7"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />
            <com.analogtv.launcher.IconView
                android:id="@+id/ctlVolDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:tag="9"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />
            <com.analogtv.launcher.IconView
                android:id="@+id/ctlMute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:tag="17"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />
            <com.analogtv.launcher.IconView
                android:id="@+id/ctlVolUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:tag="10"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />
            <com.analogtv.launcher.IconView
                android:id="@+id/ctlNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:tag="8"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Options bar -->
            <LinearLayout
                android:id="@+id/optionsBar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/qualityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality : Connecting"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View android:id="@+id/sig1" android:layout_width="7dp" android:layout_height="10dp" android:layout_marginEnd="3dp" />
                    <View android:id="@+id/sig2" android:layout_width="7dp" android:layout_height="17dp" android:layout_marginEnd="3dp" />
                    <View android:id="@+id/sig3" android:layout_width="7dp" android:layout_height="24dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/channelName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:text="Zavi TV"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.analogtv.launcher.IconView
                    android:id="@+id/btnMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:tag="4"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/sizeLabel"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Small"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <com.analogtv.launcher.IconView
                    android:id="@+id/btnPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:tag="5"
                    android:clickable="true"
                    android:focusable="true" />
                <com.analogtv.launcher.IconView
                    android:id="@+id/btnFullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:tag="3"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: weather, clock, theme dots -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/weatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅"
                    android:textSize="40sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="#DDFFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="📍 --"
                        android:textColor="#BBFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clockCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <com.analogtv.launcher.AnalogClockView
                    android:id="@+id/analogClock"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextClock
                    android:id="@+id/digitalClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm:ss a"
                    android:format24Hour="hh:mm:ss a"
                    android:paddingTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dotsRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom tiles -->
    <LinearLayout
        android:id="@+id/tilesRow"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tilePlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <com.analogtv.launcher.IconView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:tag="15" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="Live TV"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileYoutube"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <com.analogtv.launcher.IconView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:tag="11" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="YouTube"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tilePlayStore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <com.analogtv.launcher.IconView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:tag="12" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="Play Store"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <com.analogtv.launcher.IconView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:tag="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tileAllApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <com.analogtv.launcher.IconView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:tag="14" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="All Apps"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
